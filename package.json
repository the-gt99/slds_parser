{
  "name": "slds-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "node --env-file-if-exists=.env dist/src/cli/api.js",
    "build": "tsc -p tsconfig.json",
    "classifier:exact-matches": "node --env-file-if-exists=.env --import tsx src/cli/classifier-exact-matches.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate.ts",
    "goat:enqueue-discovery": "node --env-file-if-exists=.env --import tsx src/cli/goat-enqueue-discovery.ts",
    "goat:enqueue-cohort": "node --env-file-if-exists=.env --import tsx src/cli/goat-enqueue-cohort.ts",
    "goat:enqueue-smoke": "node --env-file-if-exists=.env --import tsx src/cli/goat-enqueue-smoke.ts",
    "proxy:import-env": "node --env-file-if-exists=.env --import tsx src/cli/proxy-import-env.ts",
    "proxy:test": "node --env-file-if-exists=.env --import tsx src/cli/proxy-test.ts",
    "proxy:enable": "node --env-file-if-exists=.env --import tsx src/cli/proxy-enable.ts",
    "proxy:disable": "node --env-file-if-exists=.env --import tsx src/cli/proxy-disable.ts",
    "wordpress:bootstrap": "node --env-file-if-exists=.env --import tsx src/cli/wordpress-bootstrap.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/cli/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "saxes": "^6.0.0",
    "sharp": "^0.35.3"
  }
}
