[Unit]
Description=Reconcile Shihuo WireGuard peers
After=network-online.target wg-quick@wg0.service
Requires=wg-quick@wg0.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/slds-shihuo-gateway
EnvironmentFile=/etc/slds-shihuo-gateway.env
ExecStart=/opt/slds-shihuo-gateway/venv/bin/python /opt/slds-shihuo-gateway/gateway_reconcile.py
